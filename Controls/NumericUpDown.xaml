<UserControl x:Class="DR2CDebugTool.Controls.NumericUpDown"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:namespace="DR2CDebugTool.Controls"
             x:Name="Root">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="ValueTextBox" 
         Grid.Column="0" 
         VerticalContentAlignment="Center" 
         Padding="2,0"
         LostFocus="ValueTextBox_LostFocus"
         KeyDown="ValueTextBox_KeyDown"/>
        <StackPanel Grid.Column="1" Orientation="Vertical" Margin="2,0,0,0">
            <RepeatButton Content="▲" Width="20" Height="12" Click="Increase_Click" FontSize="8" Padding="0"/>
            <RepeatButton Content="▼" Width="20" Height="12" Click="Decrease_Click" FontSize="8" Padding="0"/>
        </StackPanel>
    </Grid>
</UserControl>