<Window x:Class="DR2CDebugTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DR2CDebugTool.Controls"
        xmlns:local="clr-namespace:DR2CDebugTool"
        xmlns:helpers="clr-namespace:DR2CDebugTool.Helpers"
        Title="{Binding TitleText}" Height="850" Width="1400"
        Background="#F5F5F5" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Window.Resources>
        <Style x:Key="GridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#007ACC"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FilterComboBoxStyle" TargetType="ComboBox">
            <Setter Property="Width" Value="120"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <helpers:BindingProxy x:Key="Proxy" Data="{Binding}"/>
    </Window.Resources>
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <TextBlock Grid.Row="0" Text="{Binding TitleText}" FontSize="20" FontWeight="Bold" Margin="0,0,0,10" Foreground="#007ACC"/>

        <!-- 进程栏 -->
        <Border Grid.Row="1" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding RefreshText}" Click="RefreshProcesses_Click" Width="80"/>
                <TextBox x:Name="ProcessFilterBox" Width="120" Margin="10,0" TextChanged="ProcessFilterBox_TextChanged" ToolTip="Filter process name"/>
                <ComboBox x:Name="ProcessComboBox" Width="220" Margin="0" ItemsSource="{Binding FilteredProcesses}" DisplayMemberPath="DisplayName" SelectedValuePath="Id" SelectedItem="{Binding SelectedProcess}" IsEditable="False"/>
                <Button Content="{Binding AttachText}" Click="Attach_Click" Width="60" Margin="10,0"/>
                <TextBlock x:Name="StatusTextBlock" Text="{Binding StatusText}" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#333"/>
                <Button Content="{Binding SettingsText}" Click="OpenSettings_Click" Width="60" Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- 人物列表栏 -->
        <Border Grid.Row="2" Background="White" BorderBrush="#CCC" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <Button Content="{Binding ScanCharaText}" Click="ScanCharacters_Click" Width="120" Margin="0,0,10,0"/>
                <ComboBox x:Name="CharacterListBox" Width="250" Margin="0" ItemsSource="{Binding Player.CharacterList}" DisplayMemberPath="DisplayInfo" SelectedValuePath="Index" SelectedValue="{Binding Player.CurrentCharacterIndex}" SelectionChanged="CharacterListBox_SelectionChanged"/>
                <TextBlock Text="{Binding Player.OffsetInfoText}" Margin="20,0,0,0" VerticalAlignment="Center" Foreground="#555" FontFamily="Consolas" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- 主选项卡 -->
        <TabControl Grid.Row="3" Background="White" BorderBrush="#CCC" BorderThickness="1">
            <!-- 角色 Tab -->
            <TabItem Header="{Binding PlayerStatsTab}" Background="#F9F9F9">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <!-- 角色信息区域 -->
                        <GroupBox Header="{Binding CharacterText}" Margin="0,0,0,10">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding EntityNameText}" VerticalAlignment="Center" Margin="0,0,5,0"/>
                                <TextBox x:Name="NameBox" Grid.Row="0" Grid.Column="1" Text="{Binding Player.PlayerName, UpdateSourceTrigger=PropertyChanged}" Margin="5,0" Width="120" HorizontalAlignment="Left" PreviewKeyDown="NameBox_OnKeyDown"/>
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding EntityHPText}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <controls:NumericUpDown Grid.Row="0" Grid.Column="3" Margin="5,0" x:Name="HealthBox" Value="{Binding Player.PlayerHealth}" Minimum="-10" Maximum="65535" Width="80" ValueChanged="CharacterHealth_Changed" HorizontalAlignment="Left"/>

                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding PerkLabel}" VerticalAlignment="Center" Margin="0,5,5,0"/>
                                <TextBox x:Name="PerkBox" Grid.Row="1" Grid.Column="1" Text="{Binding Player.PlayerPerk}" Margin="5,5,0,0" Width="120" HorizontalAlignment="Left" IsReadOnly="True" Background="#F0F0F0"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding TraitLabel}" VerticalAlignment="Center" Margin="10,5,5,0"/>
                                <TextBox x:Name="TraitBox" Grid.Row="1" Grid.Column="3" Text="{Binding Player.PlayerTrait}" Margin="5,5,0,0" Width="120" HorizontalAlignment="Left" IsReadOnly="True" Background="#F0F0F0"/>
                            </Grid>
                        </GroupBox>

                        <!-- 属性表格 -->
                        <DataGrid x:Name="PlayerStatsGrid" ItemsSource="{Binding Player.PlayerStats}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                  ColumnHeaderStyle="{StaticResource GridHeaderStyle}" RowHeight="30" AlternationCount="2">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding DisplayName}" IsReadOnly="True" Width="100">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Data.AttributeHeader, Source={StaticResource Proxy}}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{Binding Data.BaseHeader, Source={StaticResource Proxy}}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:NumericUpDown Value="{Binding BaseValue, UpdateSourceTrigger=PropertyChanged}" ValueChanged="BaseValue_Changed" Minimum="-100" Maximum="100" Width="80"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="100">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{Binding Data.BonusHeader, Source={StaticResource Proxy}}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <controls:NumericUpDown Value="{Binding BonusValue, UpdateSourceTrigger=PropertyChanged}" ValueChanged="BonusValue_Changed" Minimum="-100" Maximum="100" Width="80"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="50">
                                    <DataGridTemplateColumn.Header>
                                        <TextBlock Text="{Binding Data.KnownHeader, Source={StaticResource Proxy}}"/>
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                             <CheckBox IsChecked="{Binding Known, UpdateSourceTrigger=PropertyChanged}" 
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Click="Known_Changed"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding EffectiveValue}" IsReadOnly="True" Width="80">
                                    <DataGridTextColumn.Header>
                                        <TextBlock Text="{Binding Data.EffectiveHeader, Source={StaticResource Proxy}}"/>
                                    </DataGridTextColumn.Header>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextAlignment" Value="Center"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="{Binding ReadText}" Click="ReadPlayerStats_Click" Width="120" Margin="0,10,0,0" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <!-- 实体 Tab -->
            <TabItem Header="{Binding EntitiesTab}" Background="#F9F9F9">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="500"/>
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：实体列表 -->
                    <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="5"
                            HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <DockPanel LastChildFill="True">
                            <!-- 工具栏 -->
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,5">
                                <Button Content="{Binding ScanEntitiesText}" Click="ScanEntities_Click" Width="100"/>
                                <Button Content="{Binding RefreshText}" Click="RefreshEntityList_Click" Width="70" Margin="5,0"/>
                                <TextBlock Text="|" Margin="10,0" Foreground="#CCC" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding TypeText}" VerticalAlignment="Center" Margin="5,0"/>
                                <ComboBox x:Name="EntityTypeFilter" Style="{StaticResource FilterComboBoxStyle}" SelectedIndex="{Binding Entity.TypeFilterIndex}" SelectionChanged="EntityFilter_Changed">
                                    <ComboBoxItem Content="{Binding EntityAllText}" IsSelected="True"/>
                                    <ComboBoxItem Content="{Binding EntityHumanText}"/>
                                    <ComboBoxItem Content="{Binding EntityZombieText}"/>
                                    <ComboBoxItem Content="{Binding EntityItemText}"/>
                                    <ComboBoxItem Content="{Binding EntityProjectileText}"/>
                                    <ComboBoxItem Content="{Binding EntityFurnitureText}"/>
                                    <ComboBoxItem Content="{Binding EntityPickupText}"/>
                                    <ComboBoxItem Content="{Binding EntityVehicleText}"/>
                                    <ComboBoxItem Content="{Binding EntityPickupSpecText}"/>
                                </ComboBox>
                                <TextBlock Text="{Binding AreaText}" VerticalAlignment="Center" Margin="5,0"/>
                                <ComboBox x:Name="EntityAreaFilter" Style="{StaticResource FilterComboBoxStyle}" ItemsSource="{Binding Entity.AreaOptions}" SelectedItem="{Binding Entity.AreaFilter}" SelectionChanged="EntityFilter_Changed"/>
                                <TextBlock Text="{Binding SearchText}" VerticalAlignment="Center" Margin="10,0,5,0"/>
                                <TextBox x:Name="EntitySearchBox" Text="{Binding Entity.SearchText, UpdateSourceTrigger=PropertyChanged}" Width="80" ToolTip="Search by ID"/>
                            </StackPanel>

                            <!-- 统计信息 -->
                            <TextBlock DockPanel.Dock="Top" x:Name="EntityCountText" Text="{Binding Entity.EntityCountText}" Foreground="#555" FontSize="12" Margin="2,0,0,5"/>

                            <!-- 状态栏 -->
                            <TextBlock DockPanel.Dock="Bottom" x:Name="EntityStatus" Text="{Binding Entity.EntityStatus}" Foreground="#555" FontSize="12" Margin="2,5,0,0"/>

                            <!-- 实体表格 - 全部只读 -->
                            <DataGrid x:Name="EntityDataGrid" ItemsSource="{Binding Entity.FilteredEntities}" AutoGenerateColumns="False" 
                                    CanUserAddRows="False" CanUserDeleteRows="False"
                                    SelectionMode="Single" SelectionUnit="FullRow"
                                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    RowHeight="24" AlternationCount="2"
                                    CanUserSortColumns="True"
                                    IsReadOnly="True"
                                    SelectedCellsChanged="EntityDataGrid_SelectedCellsChanged">
                                <DataGrid.Resources>
                                    <Style TargetType="DataGridRow">
                                        <Style.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter Property="Background" Value="LightSkyBlue" />
                                                <Setter Property="Foreground" Value="LightSkyBlue" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </DataGrid.Resources>
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding EntityId}" Width="45">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityID, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding TypeName}" Width="70">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityType, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding SubTypeName}" Width="60">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntitySubType, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Health}" Width="45">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityHP, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Pos.AreaId}" Width="50">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityArea, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Pos.PosX, StringFormat=F1}" Width="60">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityPosX, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Pos.PosY, StringFormat=F1}" Width="60">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityPosY, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Pos.PosZ, StringFormat=F1}" Width="60">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityPosZ, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding BaseAddress, StringFormat=X}" Width="80">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColEntityAddress, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                    
                    <!-- 分隔线 -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 右侧：实体详情 -->
                    <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="10">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{Binding EntitiesTab}" FontSize="16" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>

                                <!-- 基本信息 - ID和Type只读 -->
                                <GroupBox Header="{Binding BasicInfoText}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="ID:" Margin="0,2" FontWeight="SemiBold"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" x:Name="EntityIdBox" Text="{Binding Entity.DetailEntityId}" Margin="2,2" Width="50" HorizontalAlignment="Left" IsReadOnly="True" Background="#F0F0F0"/>
                                        
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding TypeText, StringFormat={}{0}:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <TextBox Grid.Row="0" Grid.Column="3" x:Name="EntityTypeBox" Text="{Binding Entity.DetailTypeName}" Margin="2,2" Width="70" HorizontalAlignment="Left" IsReadOnly="True" Background="#F0F0F0"/>

                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding SubTypeText, StringFormat={}{0}:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <TextBox Grid.Row="0" Grid.Column="5" x:Name="EntitySubTypeBox" Text="{Binding Entity.DetailSubTypeName}" Margin="2,2" Width="70" HorizontalAlignment="Left" IsReadOnly="True" Background="#F0F0F0"/>
                                        
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding EntityHPText, StringFormat={}{0}:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="EntityHPBox" Value="{Binding Entity.DetailHealth}" Minimum="-10" Maximum="65535" Width="60" ValueChanged="EntityHealth_Changed"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding AreaText, StringFormat={}{0}:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <TextBox Grid.Row="1" Grid.Column="3" x:Name="EntityAreaIdBox" Text="{Binding Entity.DetailAreaId}" Margin="2,2" Width="70" HorizontalAlignment="Left" IsReadOnly="True" Background="#F0F0F0"/>
                                    </Grid>
                                </GroupBox>

                                <!-- 位置信息 - 可编辑 -->
                                <GroupBox Header="{Binding PositionText}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding PosText, StringFormat={}{0} X:}" Margin="0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="EntityPosXBox" Value="{Binding Entity.DetailPosX}" Minimum="-65535" Maximum="65535" Width="60" ValueChanged="EntityPos_Changed"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding PosText, StringFormat={}{0} Y:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="0" Grid.Column="3" x:Name="EntityPosYBox" Value="{Binding Entity.DetailPosY}" Minimum="-65535" Maximum="65535" Width="60" ValueChanged="EntityPos_Changed"/>

                                        <TextBlock Grid.Row="0" Grid.Column="4" Text="{Binding PosText, StringFormat={}{0} Z:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="0" Grid.Column="5" x:Name="EntityPosZBox" Value="{Binding Entity.DetailPosZ}" Minimum="-65535" Maximum="65535" Width="60" ValueChanged="EntityPos_Changed"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{Binding VelText, StringFormat={}{0} X:}" Margin="0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="1" Grid.Column="1" x:Name="EntityVelXBox" Value="{Binding Entity.DetailVelX}" Minimum="-65535" Maximum="65535" Width="60" ValueChanged="EntityPos_Changed"/>

                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding VelText, StringFormat={}{0} Y:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="1" Grid.Column="3" x:Name="EntityVelYBox" Value="{Binding Entity.DetailVelY}" Minimum="-65535" Maximum="65535" Width="60" ValueChanged="EntityPos_Changed"/>

                                        <TextBlock Grid.Row="1" Grid.Column="4" Text="{Binding VelText, StringFormat={}{0} Z:}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="1" Grid.Column="5" x:Name="EntityVelZBox" Value="{Binding Entity.DetailVelZ}" Minimum="-65535" Maximum="65535" Width="60" ValueChanged="EntityPos_Changed"/>
                                    </Grid>
                                </GroupBox>

                                <!-- 调试属性 -->
                                <GroupBox Header="{Binding DebugPropertiesText}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                                <TextBlock Text="{Binding NoCollideText}" Margin="0,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="EntityNoCollide" IsChecked="{Binding Entity.DetailNoCollide}" VerticalAlignment="Center" Click="EntityDebugCheckBox_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding InvisibleText}" Margin="0,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="EntityInvisible" IsChecked="{Binding Entity.DetailInvisible}" VerticalAlignment="Center" Click="EntityDebugCheckBox_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Margin="0,8,0,6">
                                                <TextBlock Text="{Binding InvincibleText}" Margin="0,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="EntityInvincible" IsChecked="{Binding Entity.DetailInvincible}" VerticalAlignment="Center" Click="EntityDebugCheckBox_Click"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding GlowText}" Margin="0,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="EntityGlow" IsChecked="{Binding Entity.DetailGlow}" VerticalAlignment="Center" Click="EntityDebugCheckBox_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding MassText}" Margin="0,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <controls:NumericUpDown x:Name="EntityMass" Value="{Binding Entity.DetailMass}" Minimum="0" Maximum="65535" Width="90" ValueChanged="DebugNumeric_Changed"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FrictionText}" Margin="0,0,6,0" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                <controls:NumericUpDown x:Name="EntityFriction" Value="{Binding Entity.DetailFriction}" Minimum="-100" Maximum="100" Width="90" ValueChanged="DebugNumeric_Changed"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </GroupBox>

                                <!-- AI 属性 -->
                                <GroupBox Header="{Binding AIPropertiesText}" Margin="0,0,0,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding AIStateText}" Margin="0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="0" Grid.Column="1" x:Name="EntityAIState" Value="{Binding Entity.DetailAIState}" Minimum="0" Maximum="100" Width="60" ValueChanged="DebugNumeric_Changed"/>

                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding AIWaitText}" Margin="5,2,0,2" FontWeight="SemiBold"/>
                                        <controls:NumericUpDown Grid.Row="0" Grid.Column="3" x:Name="EntityAIWait" Value="{Binding Entity.DetailAIWait}" Minimum="0" Maximum="9999" Width="60" ValueChanged="DebugNumeric_Changed"/>
                                    </Grid>
                                </GroupBox>

                                <!-- 操作按钮 -->
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <Button Content="{Binding TeleportToTargetText}" Click="TeleportToTarget_Click" Width="100" Margin="5,0"/>
                                    <Button Content="{Binding SwapPositionsText}" Click="SwapPositions_Click" Width="100" Margin="5,0"/>
                                    <Button Content="{Binding SetTargetText}" Click="SetTarget_Click" Width="100" Margin="5,0"/>
                                </StackPanel>

                                <!-- 目标状态 -->
                                <Border Background="#F0F8FF" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,10,0,0">
                                    <TextBlock x:Name="TargetStatusText" Text="{Binding Entity.TargetStatusText}" FontSize="12" Foreground="#555"/>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>
            <!-- 武器 Tab -->
            <TabItem Header="{Binding WeaponsTab}" Background="#F9F9F9">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="2*"/>
                    </Grid.RowDefinitions>

                    <!-- 左侧上方：角色武器槽 -->
                    <Border Grid.Row="0" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="10">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding WeaponSoltText}" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,8"/>
                            
                            <Border DockPanel.Dock="Top" Background="#F0F8FF" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="6" Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentCharacterText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="WeaponCharInfo" Text="{Binding Weapon.WeaponCharInfo}" Margin="5,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="WeaponSlotsGrid" ItemsSource="{Binding Weapon.WeaponSlots}" AutoGenerateColumns="False" 
                                    CanUserAddRows="False" CanUserDeleteRows="False"
                                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                    RowHeight="30" AlternationCount="2"
                                    SelectionMode="Single" SelectionUnit="FullRow"
                                    VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding DisplayName}" Width="60" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColSlot, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTemplateColumn Width="75">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColWeaponID, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:NumericUpDown Value="{Binding WeaponId, UpdateSourceTrigger=PropertyChanged}" 
                                                                        Minimum="0" Maximum="16384" Width="55"
                                                                        ValueChanged="WeaponId_ValueChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTextColumn Binding="{Binding WeaponName}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColWeaponName, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    
                                    <DataGridTemplateColumn Width="65">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColWeaponStack, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:NumericUpDown Value="{Binding StackCount, UpdateSourceTrigger=PropertyChanged}" 
                                                                        Minimum="0" Maximum="999" Width="55"
                                                                        ValueChanged="StackCount_ValueChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    
                                    <DataGridTemplateColumn Width="50">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColWeaponLocked, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsLocked, UpdateSourceTrigger=PropertyChanged}" 
                                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                                        Click="LockedState_Changed"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 左侧下方：仓库武器 -->
                    <Border Grid.Row="2" Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="10">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding StorageWeaponText}" FontSize="14" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,8"/>

                            <DataGrid x:Name="StorageWeaponsGrid" ItemsSource="{Binding Weapon.StorageWeapons}" AutoGenerateColumns="False" 
                                    CanUserAddRows="False" CanUserDeleteRows="False"
                                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                    RowHeight="26" AlternationCount="2"
                                    VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding SlotIndex, StringFormat={}{0}}" Width="35" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColStorageIndex, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="75">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColStorageWeaponID, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:NumericUpDown Value="{Binding WeaponId, UpdateSourceTrigger=PropertyChanged}" 
                                                                        Minimum="0" Maximum="16384" Width="55"
                                                                        ValueChanged="StorageWeaponId_ValueChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Binding="{Binding WeaponName}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColStorageWeaponName, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                        <DataGridTextColumn.ElementStyle>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="TextAlignment" Value="Center"/>
                                            </Style>
                                        </DataGridTextColumn.ElementStyle>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="65">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColStorageStack, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:NumericUpDown Value="{Binding Count, UpdateSourceTrigger=PropertyChanged}" 
                                                                        Minimum="0" Maximum="255" Width="55"
                                                                        ValueChanged="StorageCount_ValueChanged"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 左侧上下之间的分隔线 -->
                    <GridSplitter Grid.Row="1" Grid.Column="0" Height="5" HorizontalAlignment="Stretch" VerticalAlignment="Center" Background="Transparent"/>

                    <!-- 分隔线（左右） -->
                    <GridSplitter Grid.Row="0" Grid.Column="1" Grid.RowSpan="3" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 右侧：武器池 -->
                    <Border Grid.Row="0" Grid.Column="2" Grid.RowSpan="3" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="10">
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{Binding ScanWeaponPoolText}" Click="ScanWeaponPool_Click" Width="120"/>
                                <Button Content="{Binding RefreshWeaponText}" Click="RefreshWeaponSlots_Click" Width="90" Margin="5,0" ToolTip="Refresh all weapon slots and storage"/>
                                <TextBlock Text="|" Margin="10,0" Foreground="#CCC" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SearchText}" VerticalAlignment="Center" Margin="5,0"/>
                                <TextBox x:Name="WeaponSearchBox" Text="{Binding Weapon.WeaponSearchText, UpdateSourceTrigger=PropertyChanged}" Width="120"/>
                            </StackPanel>

                            <TextBlock DockPanel.Dock="Top" x:Name="WeaponCountText" Text="{Binding Weapon.WeaponCountText}" Foreground="#555" FontSize="12" Margin="0,0,0,5"/>

                            <DataGrid x:Name="WeaponPoolGrid" ItemsSource="{Binding Weapon.FilteredWeaponPool}" AutoGenerateColumns="False"
                                    CanUserAddRows="False" CanUserDeleteRows="False"
                                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                    RowHeight="24" AlternationCount="2"
                                    SelectionMode="Single" SelectionUnit="FullRow"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Id}" Width="50" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColPoolID, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTextColumn Binding="{Binding Name}" Width="260" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColPoolName, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <!-- 资源 Tab -->
            <TabItem Header="{Binding ResourcesTab}" Background="#F9F9F9">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 全局资源 (仓库) -->
                    <Border Grid.Column="0" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="10">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding GlobalResourcesText}" FontSize="16" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>
                            
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{Binding ReadText}" Click="ReadGlobalResources_Click" Width="100"/>
                                <Button Content="{Binding ApplyText}" Click="ApplyGlobalResources_Click" Width="100" Margin="5,0"/>
                            </StackPanel>

                            <DataGrid x:Name="GlobalResourcesGrid" ItemsSource="{Binding Resource.GlobalResources}" AutoGenerateColumns="False" 
                                    CanUserAddRows="False" CanUserDeleteRows="False"
                                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                    RowHeight="32" AlternationCount="2"
                                    VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Name}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColResourceName, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColResourceValue, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:NumericUpDown Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                                        Minimum="0" Maximum="999999" Width="80"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <!-- 分隔线 -->
                    <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent"/>

                    <!-- 玩家资源 -->
                    <Border Grid.Column="2" BorderBrush="#DDD" BorderThickness="1" CornerRadius="5" Background="White" Padding="10">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Top" Text="{Binding PlayerResourcesText}" FontSize="16" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>
                            
                            <Border DockPanel.Dock="Top" Background="#F0F8FF" BorderBrush="#007ACC" BorderThickness="1" CornerRadius="3" Padding="8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding CurrentCharacterText}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="ResourceCharInfo" Text="{Binding Resource.ResourceCharInfo}" Margin="5,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="{Binding ReadText}" Click="ReadPlayerResources_Click" Width="100"/>
                                <Button Content="{Binding ApplyText}" Click="ApplyPlayerResources_Click" Width="100" Margin="5,0"/>
                            </StackPanel>

                            <DataGrid x:Name="PlayerResourcesGrid" ItemsSource="{Binding Resource.PlayerResources}" AutoGenerateColumns="False" 
                                    CanUserAddRows="False" CanUserDeleteRows="False"
                                    ColumnHeaderStyle="{StaticResource GridHeaderStyle}"
                                    RowHeight="32" AlternationCount="2"
                                    VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Name}" Width="120" IsReadOnly="True">
                                        <DataGridTextColumn.Header>
                                            <TextBlock Text="{Binding Data.ColResourceName, Source={StaticResource Proxy}}"/>
                                        </DataGridTextColumn.Header>
                                    </DataGridTextColumn>
                                    <DataGridTemplateColumn Width="100">
                                        <DataGridTemplateColumn.Header>
                                            <TextBlock Text="{Binding Data.ColResourceValue, Source={StaticResource Proxy}}"/>
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <controls:NumericUpDown Value="{Binding Value, UpdateSourceTrigger=PropertyChanged}" 
                                                                        Minimum="0" Maximum="65535" Width="80"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="{Binding AdvancedTab}" Background="#F9F9F9">
                <StackPanel Margin="10">
                    <GroupBox Header="⚙️ Attribute Upper Limit" Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding NewMaxText}" VerticalAlignment="Center" FontWeight="SemiBold"/>
                            <Button Content="{Binding ApplyText}" Click="ChangeMax_Click" Margin="10,0" Width="120"/>
                            <TextBlock x:Name="MaxStatus" Text="{Binding Advanced.MaxStatus}" Margin="15,0,0,0" VerticalAlignment="Center" Foreground="#555"/>
                        </StackPanel>
                    </GroupBox>
                    <GroupBox Header="ℹ️ Current Offsets" Margin="0,10,0,0">
                        <TextBlock Text="{Binding Advanced.OffsetInfoText}" TextWrapping="Wrap" FontFamily="Consolas" FontSize="13" Foreground="#333"/>
                    </GroupBox>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>