<Window x:Class="DR2CDebugTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="720" Width="620"
        WindowStartupLocation="CenterOwner" Background="#F9F9F9">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="220"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="Settings" FontSize="18" FontWeight="Bold" Foreground="#007ACC" Margin="0,0,0,10"/>

            <Border Grid.Row="1" Grid.ColumnSpan="2" Background="White" BorderBrush="#DDD" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="LanguageLabel" Grid.Column="0" Text="Language:" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0"/>
                    <ComboBox x:Name="LanguageCombo" Grid.Column="1" Margin="0,0,0,0" SelectedIndex="0">
                        <ComboBoxItem Content="English" Tag="en-US"/>
                        <ComboBoxItem Content="中文" Tag="zh-CN"/>
                    </ComboBox>
                </Grid>
            </Border>

            <GroupBox Grid.Row="2" Grid.ColumnSpan="2" Header="Player Settings" Margin="0,0,0,10" BorderBrush="#007ACC">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="PlayerArrayOffsetLabel" Grid.Row="0" Grid.Column="0" Text="Player Array Offset (hex):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="PlayerArrayOffsetBox" Grid.Row="0" Grid.Column="1" Margin="5,2" Text="5E25D8"/>

                    <TextBlock x:Name="PlayerStructSizeLabel" Grid.Row="1" Grid.Column="0" Text="Player Struct Size (hex):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="PlayerStructSizeBox" Grid.Row="1" Grid.Column="1" Margin="5,2" Text="2E0"/>

                    <TextBlock x:Name="PlayerBaseOffsetLabel" Grid.Row="2" Grid.Column="0" Text="Player Base Offset (stat@):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="PlayerBaseOffsetBox" Grid.Row="2" Grid.Column="1" Margin="5,2" Text="1C9"/>

                    <TextBlock x:Name="PlayerBonusOffsetLabel" Grid.Row="3" Grid.Column="0" Text="Player Bonus Offset (bonus@):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="PlayerBonusOffsetBox" Grid.Row="3" Grid.Column="1" Margin="5,2" Text="1E3"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="3" Grid.ColumnSpan="2" Header="Entity Settings" Margin="0,0,0,10" BorderBrush="#007ACC">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="EntityPoolOffsetLabel" Grid.Row="0" Grid.Column="0" Text="Entity Pool Offset (hex):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="EntityPoolOffsetBox" Grid.Row="0" Grid.Column="1" Margin="5,2" Text="5632E0"/>

                    <TextBlock x:Name="EntitySizeLabel" Grid.Row="1" Grid.Column="0" Text="Entity Size (hex):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="EntitySizeBox" Grid.Row="1" Grid.Column="1" Margin="5,2" Text="304"/>

                    <TextBlock x:Name="StorageOffsetLabel" Grid.Row="2" Grid.Column="0" Text="Storage Offset (hex):" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="StorageOffsetBox" Grid.Row="2" Grid.Column="1" Margin="5,2" Text="5E2260"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="4" Grid.ColumnSpan="2" Header="Weapon Settings" Margin="0,0,0,10" BorderBrush="#007ACC">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="WeaponPoolOffsetLabel" Grid.Row="0" Grid.Column="0" Text="Weapon Pool Offset (hex):" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="WeaponPoolOffsetBox" Grid.Row="0" Grid.Column="1" Margin="5,2" Text="4E0080"/>

                    <TextBlock x:Name="WeaponSizeLabel" Grid.Row="1" Grid.Column="0" Text="Weapon Size (hex):" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="WeaponSizeBox" Grid.Row="1" Grid.Column="1" Margin="5,2" Text="1C4"/>

                    <TextBlock x:Name="MaxWeaponsLabel" Grid.Row="2" Grid.Column="0" Text="Max Weapons (hex):" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="MaxWeaponsBox" Grid.Row="2" Grid.Column="1" Margin="5,2" Text="401"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="5" Grid.ColumnSpan="2" Header="Storage Weapon Settings" Margin="0,0,0,10" BorderBrush="#007ACC">
                <Grid Margin="5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="StorageWeaponOffsetLabel" Grid.Row="0" Grid.Column="0" Text="Storage Weapon Offset (hex):" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="StorageWeaponOffsetBox" Grid.Row="0" Grid.Column="1" Margin="5,2" Text="5E2280"/>

                    <TextBlock x:Name="StorageWeaponSlotsLabel" Grid.Row="1" Grid.Column="0" Text="Storage Weapon Slots:" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="StorageWeaponSlotsBox" Grid.Row="1" Grid.Column="1" Margin="5,2" Text="15"/>

                    <TextBlock x:Name="StorageWeaponSizeLabel" Grid.Row="2" Grid.Column="0" Text="Storage Weapon Size (hex):" FontWeight="SemiBold" Margin="0,2"/>
                    <TextBox x:Name="StorageWeaponSizeBox" Grid.Row="2" Grid.Column="1" Margin="5,2" Text="8"/>
                </Grid>
            </GroupBox>

            <StackPanel Grid.Row="6" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,5,0,0">
                <Button x:Name="ApplySetting" Content="OK" Click="OK_Click" Width="70" Margin="5" Background="#007ACC" Foreground="White" BorderThickness="0" Padding="8,4"/>
                <Button x:Name="CancelSetting" Content="Cancel" Click="Cancel_Click" Width="70" Margin="5" Background="#CCC" Foreground="Black" BorderThickness="0" Padding="8,4"/>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>